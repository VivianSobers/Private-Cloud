# ---- secrets ----
.env
*.env
# .env and *.env do NOT cover Vite's .env.local / .env.production.local, which
# is where a frontend secret would actually land — neither pattern matches a
# name that merely STARTS with ".env". The negations below must stay after this
# line or they are overridden.
.env.*
!.env.example
!deploy/secrets/.env.example
deploy/secrets/*.key
deploy/secrets/*.age
deploy/secrets/*.token
*.pem
*.p12
id_rsa*
id_ed25519*

# ---- restic / backup material ----
restic-password*
.restic-repo-cache/

# ---- runtime state that must never enter git ----
deploy/compose/data/
deploy/monitoring/grafana/data/
deploy/caddy/data/
deploy/caddy/config/

# ---- Go build artifacts (Phase 1) ----
server/bin/
server/coverage.out
server/coverage.html

# ---- sync client (Phase 3) ----
# Built binary and a real filled-in config; the .example is tracked.
client/pcsync
client/cmd/pcsync/pcsync
client/config.json
# The client's own state directory, if someone syncs a folder inside the repo.
.pcsync/

# ---- editor / OS ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# TLS certificates and keys issued by scripts/tailscale-cert.sh. A private key
# in git is a private key everywhere git has ever been, including every clone
# and every mirror; the .gitkeep is allowed through so the bind mount has a
# directory to point at.
deploy/caddy/certs/*
!deploy/caddy/certs/.gitkeep
