# This repo is authored on Windows but executed on Ubuntu.
# Shell scripts and config MUST use LF endings or bash/systemd will fail with
# confusing errors ("/bin/bash^M: bad interpreter", unit files silently ignored).
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
Caddyfile text eol=lf
*.md      text eol=lf

# Never mangle binaries
*.png binary
*.jpg binary
*.gz  binary

# Extensionless executables and Dockerfiles are covered by the catch-all above,
# but named explicitly because a CRLF here is the "bad interpreter" error that
# reads as nonsense.
deploy/host/nut/privatecloud-ups-notify text eol=lf
Dockerfile*    text eol=lf
*.json         text eol=lf
*.py           text eol=lf
