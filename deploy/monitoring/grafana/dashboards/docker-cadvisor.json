    {
      "type": "timeseries",
      "title": "Restarts",
      "description": "A container restarting on its own is the signal that arrives before the one you were watching for. Two of these run privileged (cadvisor, smartctl_exporter) and are documented exceptions, not oversights.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
