# ---------------------------------------------------------------------------
# Private cloud — environment template.
#
#   cp deploy/secrets/.env.example deploy/compose/.env
#   chmod 600 deploy/compose/.env
#
# The real .env is gitignored and MUST stay that way. Docker Compose reads .env
# from the directory containing docker-compose.yml, which is why it goes in
# deploy/compose/ rather than next to this template.
#
# Generate every secret below with:  openssl rand -base64 32
# Do not reuse passwords between services. Do not type them by hand.
# ---------------------------------------------------------------------------

# --- Tailscale ------------------------------------------------------------
# The server's Tailscale IPv4 (100.x.y.z). Get it with: tailscale ip -4
# Every published port binds to this address only. If it is wrong, the stack
# is unreachable; if it is empty, compose refuses to start (by design — an
# unset value would otherwise mean binding 0.0.0.0 and exposing Grafana).
#
# Left EMPTY on purpose. docker-compose.yml guards it with
# ${TAILSCALE_IP:?...}, which fires on unset *or* empty and prints the
# instruction. A half-written placeholder like "100." is neither, so it slips
# past the guard and you get "invalid IP address: 100." from the port parser
# instead of being told what to do about it.
TAILSCALE_IP=

# MagicDNS short hostname and tailnet domain, used to build URLs.
# `tailscale status --json | jq -r .MagicDNSSuffix` gives the tailnet part.
TS_HOSTNAME=cloud
TS_TAILNET=your-tailnet.ts.net

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=privatecloud
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=privatecloud

# --- Postgres memory/IO tuning (per-box) ----------------------------------
# The compose file defaults to the LOW-MEMORY DEV profile shown below, so on
# this ~7 GB dev box you can leave these unset. When you move to the 16 GB
# production server, uncomment the PRODUCTION block instead.
#
# DEV (~7 GB RAM, pool on a spinning disk) — these match the compose defaults:
#   PG_SHARED_BUFFERS=512MB
#   PG_EFFECTIVE_CACHE_SIZE=1536MB
#   PG_WORK_MEM=16MB
#   PG_MAINTENANCE_WORK_MEM=128MB
#   PG_MAX_CONNECTIONS=50
#   PG_RANDOM_PAGE_COST=4.0        # spinning disk; SSD/ARC-backed wants 1.1
#
# PRODUCTION (16 GB RAM, SSD/ARC-backed mirror) — uncomment to use:
#   PG_SHARED_BUFFERS=1GB
#   PG_EFFECTIVE_CACHE_SIZE=3GB
#   PG_WORK_MEM=32MB
#   PG_MAINTENANCE_WORK_MEM=256MB
#   PG_MAX_CONNECTIONS=100
#   PG_RANDOM_PAGE_COST=1.1

# --- ZFS ARC --------------------------------------------------------------
# Not read by Docker — set when running scripts/zfs-setup.sh. Left empty, the
# script auto-sizes ARC to 1/4 of RAM (capped 6 GiB): ~1.7 GiB here, 4 GiB on
# a 16 GB box. Override with an explicit byte count if you want:
#   ARC_MAX_BYTES=1610612736        # 1.5 GiB, e.g. to leave the desktop more room

# --- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# --- API (Phase 1) --------------------------------------------------------
# The API reuses POSTGRES_USER/PASSWORD/DB above to build its connection URL,
# so there is one source of truth for the database password.
#
# PC_ENV=prod gives JSON logs (Loki-parseable). Use dev + text while developing.
PC_ENV=prod
PC_LOG_LEVEL=info
PC_LOG_FORMAT=json
#
# Stamped into the binary and exported as privatecloud_build_info, so a Grafana
# panel can tell you exactly which build is running. Set by CI later; for now
# a manual build is fine:
#   API_VERSION=$(git describe --tags --always --dirty)
#   API_COMMIT=$(git rev-parse --short HEAD)
API_VERSION=dev
API_COMMIT=none

# --- WebAuthn / passkeys (Phase 1 slice 2) --------------------------------
# RPID is the domain passkeys are bound to. BARE DOMAIN ONLY — no scheme, no
# port, no path. The API refuses to start if you include one, because the
# browser-side error for a wrong RPID is famously unhelpful.
#
# WARNING: changing RPID INVALIDATES EVERY EXISTING PASSKEY. Passkeys are bound
# to the origin that created them. Decide your final hostname before enrolling
# keys you care about — for this setup that means the MagicDNS name.
PC_WEBAUTHN_RPID=cloud.your-tailnet.ts.net
PC_WEBAUTHN_RP_NAME=Private Cloud

# Full origins, WITH scheme, comma-separated. These must exactly match what the
# browser shows in the address bar.
PC_WEBAUTHN_ORIGINS=https://cloud.your-tailnet.ts.net

# --- sessions -------------------------------------------------------------
PC_SESSION_TTL=720h
PC_COOKIE_NAME=pc_session
# Refused when PC_ENV=prod, so session cookies cannot ship in the clear by
# accident. Only set false for a local plain-HTTP dev run.
PC_COOKIE_SECURE=true

# --- file storage (Phase 1 slice 3) ---------------------------------------
# Where file content is stored ON THE HOST. This MUST be inside the ZFS dataset
# that sanoid snapshots and restic backs up. A path outside it — including any
# Docker named volume — is silently unprotected, and you will not find out
# until the day you need a restore.
#
# The directory must exist and be owned by the API's uid (65532, from the
# distroless nonroot image) before the stack starts:
#
#   sudo install -d -o 65532 -g 65532 -m 0700 /tank/data/blobs
#
PC_BLOB_HOST_PATH=/tank/data/blobs

# How long deleted files stay in the trash before being purged for good. They
# occupy disk and count against quota for the whole window — that is honest,
# because the bytes really are still there.
PC_TRASH_RETENTION=720h

# How often the API sweeps expired trash and unreferenced content. Six hours is
# unhurried on purpose: nothing about reclaiming already-unreferenced space is
# urgent, and a tighter loop is just extra IO competing with real work.
PC_BLOB_GC_INTERVAL=6h

# How long an abandoned resumable upload keeps its partial bytes on disk.
# Generous on purpose: a large file over a slow link legitimately spans days of
# intermittent connectivity, and expiring it mid-transfer costs the user
# everything they had already sent.
PC_UPLOAD_TTL=48h

# ---------------------------------------------------------------------------
# BACKUP CONFIG
#
# These are read by scripts/restic-backup.sh, NOT by Docker Compose. They live
# in a separate file that root owns, because the backup runs as a systemd unit
# outside Docker:
#
#   sudo mkdir -p /etc/private-cloud
#   sudo cp deploy/secrets/.env.example /etc/private-cloud/backup.env
#   sudo chmod 600 /etc/private-cloud/backup.env
#   sudo chown root:root /etc/private-cloud/backup.env
# ---------------------------------------------------------------------------

# --- restic repository ----------------------------------------------------
# UNDECIDED as of Phase 0 — pick one and uncomment. Until this points at a
# machine that is not this one, you do not have a backup, you have a copy.
#
# Option A — offsite box (Pi + USB disk) at a relative's house, over Tailscale.
#   This is the recommended target: real offsite, $0/month, private transport.
#   Requires an SSH key: ssh-keygen -t ed25519 -f /root/.ssh/restic_ed25519
#   then ssh-copy-id to the remote, and confirm `ssh backup-pi` works as root.
# RESTIC_REPOSITORY=sftp:backup@backup-pi:/srv/restic/private-cloud
#
# Option B — local external USB disk. Fast and useful, but NOT offsite: a
#   fire, a theft, or a lightning strike takes it along with the server.
#   Best used detached between runs, which also defeats ransomware.
# RESTIC_REPOSITORY=/mnt/backup-usb/restic/private-cloud
#
# Option C — any rclone remote (S3, B2, Storj...). Costs money but survives
#   anything. B2 at ~$6/TB/month is the usual pick if you want zero-effort.
# RESTIC_REPOSITORY=rclone:b2:my-bucket/private-cloud
#
RESTIC_REPOSITORY=

# The restic repo password, in a root-only file. NOT the password itself here.
#   openssl rand -base64 32 | sudo tee /etc/private-cloud/restic-password
#   sudo chmod 600 /etc/private-cloud/restic-password
#
# PRINT THIS PASSWORD AND PUT IT SOMEWHERE PHYSICAL. restic has no recovery
# mechanism: lose it and every backup you have ever taken is permanently
# unreadable. This is the single most dangerous secret in the system.
RESTIC_PASSWORD_FILE=/etc/private-cloud/restic-password

# SSH key for the sftp: target (Option A only).
# RESTIC_OPTIONS=
# export RESTIC_SFTP_COMMAND may be needed for a non-default key/port:
# sftp.args=-i /root/.ssh/restic_ed25519 -p 22

# --- what gets backed up ---------------------------------------------------
# tank/configs and tank/postgres are always included. tank/blobs — the actual
# file CONTENT — is included by default from Phase 1 onward, because it is the
# only copy of data nobody can recreate. A database snapshot without its blobs
# restores to a tree full of filenames whose bytes are gone.
#
# Set this to false ONLY if you have deliberately sized an offsite target that
# cannot hold the content and accept that a restore gives you names and nothing
# else. Sizing note: with Phase 2 dedup, blobs compress and dedup well, so the
# offsite requirement is usually far smaller than `zfs list` suggests.
# BACKUP_BLOBS=true

# --- restic retention -----------------------------------------------------
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# --- backup freshness metric ----------------------------------------------
# restic-backup.sh writes a Prometheus textfile metric after every run so the
# BackupTooOld alert can fire when backups silently stop. Defaults to the path
# node_exporter reads; only set this if you moved the textfile directory.
# TEXTFILE_DIR=/var/lib/node_exporter/textfile

# --- ntfy notification for backup results ---------------------------------
# The backup script runs on the HOST, outside Docker's networks, so it cannot
# use Docker service names — and ntfy's port is published on the Tailscale IP
# only (never 0.0.0.0, never 127.0.0.1). Use the same address as TAILSCALE_IP:
NTFY_URL=http://100.x.y.z:8080/private-cloud-critical
# Create a publishing token: docker exec -it privatecloud-ntfy ntfy token add backup
NTFY_TOKEN=

# ==========================================================================
# Phase 4 — intelligence & single sign-on (all optional; empty = off)
# ==========================================================================

# --- semantic search --------------------------------------------------------
# The embed-sidecar runs the embedding model (GPU-optional) behind the
# `semantic` compose profile. To enable semantic search, start it with
#   docker compose --profile semantic up -d
# and set PC_EMBED_URL to its in-network address. Empty leaves lexical + OCR
# search fully working and the semantic endpoint reporting "unavailable".
# PC_EMBED_URL=http://embed-sidecar:8000
# Set PC_ENABLE_SEMANTIC=true (without PC_EMBED_URL on this worker) to have the
# co-located worker enqueue embed jobs for a SEPARATE GPU worker to drain — see
# deploy/embed-sidecar/README.md for the split-tier setup.
# PC_ENABLE_SEMANTIC=true
# PC_EMBED_MODEL and PC_EMBED_DIM MUST match the sidecar's model (below).
PC_EMBED_MODEL=bge-small-en-v1.5
PC_EMBED_DIM=384
# The HuggingFace model the sidecar loads. On a 4090 you can afford a larger
# model (bge-base/large) — update PC_EMBED_DIM to match its dimension.
PC_EMBED_HF_MODEL=BAAI/bge-small-en-v1.5

# --- OIDC single sign-on ----------------------------------------------------
# Optional, additive to passkeys. Empty PC_OIDC_ISSUER disables SSO entirely;
# the passkey and recovery paths are unchanged either way. The redirect URL
# must be registered at the provider and point at:
#   https://<your-domain>/api/v1/auth/oidc/callback
# PC_OIDC_ISSUER=https://accounts.google.com
# PC_OIDC_CLIENT_ID=
# PC_OIDC_CLIENT_SECRET=
# PC_OIDC_REDIRECT_URL=https://cloud.example.ts.net/api/v1/auth/oidc/callback
# Restrict sign-in to specific email domains (comma-separated); empty allows any.
# PC_OIDC_ALLOWED_DOMAINS=example.com
