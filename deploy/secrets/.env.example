# ---------------------------------------------------------------------------
# Private cloud — environment template.
#
#   cp deploy/secrets/.env.example deploy/compose/.env
#   chmod 600 deploy/compose/.env
#
# The real .env is gitignored and MUST stay that way. Docker Compose reads .env
# from the directory containing docker-compose.yml, which is why it goes in
# deploy/compose/ rather than next to this template.
#
# Generate every secret below with:  openssl rand -base64 32
# Do not reuse passwords between services. Do not type them by hand.
# ---------------------------------------------------------------------------

# --- Tailscale ------------------------------------------------------------
# The server's Tailscale IPv4 (100.x.y.z). Get it with: tailscale ip -4
# Every published port binds to this address only. If it is wrong, the stack
# is unreachable; if it is empty, compose refuses to start (by design — an
# unset value would otherwise mean binding 0.0.0.0 and exposing Grafana).
TAILSCALE_IP=100.

# MagicDNS short hostname and tailnet domain, used to build URLs.
# `tailscale status --json | jq -r .MagicDNSSuffix` gives the tailnet part.
TS_HOSTNAME=cloud
TS_TAILNET=your-tailnet.ts.net

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=privatecloud
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=privatecloud

# --- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# BACKUP CONFIG
#
# These are read by scripts/restic-backup.sh, NOT by Docker Compose. They live
# in a separate file that root owns, because the backup runs as a systemd unit
# outside Docker:
#
#   sudo mkdir -p /etc/private-cloud
#   sudo cp deploy/secrets/.env.example /etc/private-cloud/backup.env
#   sudo chmod 600 /etc/private-cloud/backup.env
#   sudo chown root:root /etc/private-cloud/backup.env
# ---------------------------------------------------------------------------

# --- restic repository ----------------------------------------------------
# UNDECIDED as of Phase 0 — pick one and uncomment. Until this points at a
# machine that is not this one, you do not have a backup, you have a copy.
#
# Option A — offsite box (Pi + USB disk) at a relative's house, over Tailscale.
#   This is the recommended target: real offsite, $0/month, private transport.
#   Requires an SSH key: ssh-keygen -t ed25519 -f /root/.ssh/restic_ed25519
#   then ssh-copy-id to the remote, and confirm `ssh backup-pi` works as root.
# RESTIC_REPOSITORY=sftp:backup@backup-pi:/srv/restic/private-cloud
#
# Option B — local external USB disk. Fast and useful, but NOT offsite: a
#   fire, a theft, or a lightning strike takes it along with the server.
#   Best used detached between runs, which also defeats ransomware.
# RESTIC_REPOSITORY=/mnt/backup-usb/restic/private-cloud
#
# Option C — any rclone remote (S3, B2, Storj...). Costs money but survives
#   anything. B2 at ~$6/TB/month is the usual pick if you want zero-effort.
# RESTIC_REPOSITORY=rclone:b2:my-bucket/private-cloud
#
RESTIC_REPOSITORY=

# The restic repo password, in a root-only file. NOT the password itself here.
#   openssl rand -base64 32 | sudo tee /etc/private-cloud/restic-password
#   sudo chmod 600 /etc/private-cloud/restic-password
#
# PRINT THIS PASSWORD AND PUT IT SOMEWHERE PHYSICAL. restic has no recovery
# mechanism: lose it and every backup you have ever taken is permanently
# unreadable. This is the single most dangerous secret in the system.
RESTIC_PASSWORD_FILE=/etc/private-cloud/restic-password

# SSH key for the sftp: target (Option A only).
# RESTIC_OPTIONS=
# export RESTIC_SFTP_COMMAND may be needed for a non-default key/port:
# sftp.args=-i /root/.ssh/restic_ed25519 -p 22

# --- restic retention -----------------------------------------------------
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# --- ntfy notification for backup results ---------------------------------
# Reached over the Tailscale IP because the backup script runs on the host,
# outside Docker's networks.
NTFY_URL=http://127.0.0.1:8080/private-cloud-critical
# Create a publishing token: docker exec -it privatecloud-ntfy ntfy token add backup
NTFY_TOKEN=
